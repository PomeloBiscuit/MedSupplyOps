# 複製成 .env 後填入實際密碼。.env 已被 .gitignore 排除，不會進 repo（SEC-5）。
#
# Oracle 密碼規則：至少 8 碼，含大寫、小寫、數字。
# 避開 @ / \ : " ' # $ —— EZConnect 連線字串的格式是 帳號/密碼@//主機:埠/服務名，
# 密碼裡有 @ 或 / 會讓字串在錯誤的位置被切開，而症狀看起來像「帳號密碼錯誤」。

# SYS / SYSTEM / PDBADMIN 的密碼。只用於容器內管理，應用程式不會拿它連線。
ORACLE_SYS_PASSWORD=ChangeMe_Sys2026

# 應用程式帳號 MEDSUPPLY 的密碼。這才是 app 實際使用的帳號（最小權限）。
APP_DB_PASSWORD=ChangeMe_App2026
