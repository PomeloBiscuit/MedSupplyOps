@using System.Globalization
@model MedSupplyOps.Web.Models.Inventory.InventoryIndexViewModel
@{
    ViewData["Title"] = L["庫存查詢"];
    var dateFormat = CultureInfo.GetCultureInfo("zh-TW");
}

<div class="mso-page">
<div class="mso-page-heading d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">@L["庫存查詢"]</h1>
        <p class="text-muted mb-0">@L["基準日："]@Model.AsOf.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</p>
    </div>
    <form method="get" class="d-flex flex-wrap align-items-end gap-2">
        <div>
            <label class="form-label mb-1" for="search">@L["搜尋料號、品名或條碼"]</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" maxlength="200" />
        </div>
        <div>
            <label class="form-label mb-1" for="asOf">@L["查詢基準日"]</label>
            <input class="form-control" id="asOf" name="asOf" type="date" value="@Model.AsOf.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
        </div>
        <button class="btn btn-outline-primary" type="submit">@L["搜尋"]</button>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["清除"]</a>
    </form>
</div>

<section class="card mso-feature-card mb-4" aria-labelledby="availability-heading">
    <div class="card-body">
        <h2 class="h5" id="availability-heading">@L["即時可用量查詢"]</h2>
        <p class="text-muted">@L["選取品項後，會在不重新整理整頁的情況下讀取即時可用量與最早可用效期。"]</p>
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label" for="availability-item">@L["品項"]</label>
                <select class="form-select" id="availability-item" data-api-template="@Url.Content("~/api/items/{itemId}/availability")">
                    <option value="">@L["請選擇品項"]</option>
                    @foreach (var item in Model.Items)
                    {
                        <option value="@item.Summary.ItemId">@item.SelectionLabel</option>
                    }
                </select>
            </div>
            <input id="inventory-as-of" type="hidden" value="@Model.AsOf.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
            <div class="col-md-6">
                <output class="d-block border rounded p-3 bg-light" id="availability-result" aria-live="polite">@L["尚未選擇品項。"]</output>
            </div>
        </div>
    </div>
</section>

<section class="card mso-table-card" aria-labelledby="inventory-list-heading">
    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h2 class="h5 mb-0" id="inventory-list-heading">@L["庫存總覽"]</h2>
        <span class="text-muted small">@L["可展開查看各批次明細"]</span>
    </div>
<div class="table-responsive mso-table-scroll">
    <table class="table align-middle mb-0 mso-data-table">
        <thead>
            <tr>
                <th scope="col">@L["料號"]</th>
                <th scope="col">@L["品名"]</th>
                <th scope="col">@L["規格"]</th>
                <th scope="col">@L["單位"]</th>
                <th scope="col" class="text-end">@L["可用量"]</th>
                <th scope="col" class="text-end">@L["安全存量"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="6" class="mso-empty-state text-center">@L["目前沒有可顯示的庫存品項。"]</td></tr>
            }
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="mso-code-cell">@item.Summary.ItemCode</td>
                    <td class="text-break mso-long-text">@item.Summary.ItemName</td>
                    <td class="text-break">@item.Summary.Specification</td>
                    <td>@item.Summary.UnitOfMeasure</td>
                    <td class="text-end">@item.Summary.AvailableQuantity.ToString("N0", dateFormat)</td>
                    <td class="text-end">@item.Summary.SafetyStockQuantity.ToString("N0", dateFormat)</td>
                </tr>
                <tr>
                    <td colspan="6" class="pt-0">
                        <details>
                            <summary class="btn btn-sm btn-outline-secondary">@L["展開批次明細（{0} 批）", item.Lots.Count]</summary>
                            <div class="table-responsive mso-table-scroll mt-2">
                                <table class="table table-sm mb-0 mso-data-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">@L["批號"]</th>
                                            <th scope="col">@L["效期"]</th>
                                            <th scope="col" class="text-end">@L["數量"]</th>
                                            <th scope="col">@L["儲位"]</th>
                                            <th scope="col">@L["狀態"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var lot in item.Lots)
                                        {
                                            var isExpired = lot.ExpiryDate < Model.AsOf;
                                            var isZeroQuantity = lot.Quantity == 0;
                                            <tr class="@(!lot.IsAvailable ? "table-warning" : string.Empty)">
                                                <td class="mso-code-cell">@lot.LotNumber</td>
                                                <td>@lot.ExpiryDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                                                <td class="text-end">@lot.Quantity.ToString("N0", dateFormat)</td>
                                                <td>@lot.StorageLocation</td>
                                                <td>
                                                    @if (lot.IsAvailable)
                                                    {
                                                        <span class="badge mso-badge-ok">@L["可用"]</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge mso-badge-bad">@L["不可用"]</span>
                                                        @if (isExpired)
                                                        {
                                                            <span class="ms-1">@L["已過期"]</span>
                                                        }
                                                        @if (isZeroQuantity)
                                                        {
                                                            <span class="ms-1">@L["零量"]</span>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</section>
</div>

@section Scripts {
    <script src="~/js/inventory-availability.js" asp-append-version="true"></script>
}
