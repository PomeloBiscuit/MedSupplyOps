@using System.Globalization
@model MedSupplyOps.Web.Models.Inventory.InventoryIndexViewModel
@{
    ViewData["Title"] = "庫存查詢";
    var dateFormat = CultureInfo.GetCultureInfo("zh-TW");
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">庫存查詢</h1>
        <p class="text-muted mb-0">基準日：@Model.AsOf.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</p>
    </div>
    <form method="get" class="d-flex align-items-end gap-2">
        <div>
            <label class="form-label mb-1" for="asOf">查詢基準日</label>
            <input class="form-control" id="asOf" name="asOf" type="date" value="@Model.AsOf.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
        </div>
        <button class="btn btn-outline-primary" type="submit">更新</button>
    </form>
</div>

<section class="card mb-4" aria-labelledby="availability-heading">
    <div class="card-body">
        <h2 class="h5" id="availability-heading">即時可用量查詢</h2>
        <p class="text-muted">選取品項後，會在不重新整理整頁的情況下讀取即時可用量與最早可用效期。</p>
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label" for="availability-item">品項</label>
                <select class="form-select" id="availability-item" data-api-template="@Url.Content("~/api/items/{itemId}/availability")">
                    <option value="">請選擇品項</option>
                    @foreach (var item in Model.Items)
                    {
                        <option value="@item.Summary.ItemId">@item.Summary.ItemCode — @item.Summary.ItemName</option>
                    }
                </select>
            </div>
            <input id="inventory-as-of" type="hidden" value="@Model.AsOf.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
            <div class="col-md-6">
                <output class="d-block border rounded p-3 bg-light" id="availability-result" aria-live="polite">尚未選擇品項。</output>
            </div>
        </div>
    </div>
</section>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">料號</th>
                <th scope="col">品名</th>
                <th scope="col">規格</th>
                <th scope="col">單位</th>
                <th scope="col" class="text-end">可用量</th>
                <th scope="col" class="text-end">安全存量</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Summary.ItemCode</td>
                    <td class="text-break">@item.Summary.ItemName</td>
                    <td class="text-break">@item.Summary.Specification</td>
                    <td>@item.Summary.UnitOfMeasure</td>
                    <td class="text-end">@item.Summary.AvailableQuantity.ToString("N0", dateFormat)</td>
                    <td class="text-end">@item.Summary.SafetyStockQuantity.ToString("N0", dateFormat)</td>
                </tr>
                <tr>
                    <td colspan="6" class="pt-0">
                        <details>
                            <summary class="btn btn-sm btn-outline-secondary">展開批次明細（@item.Lots.Count 批）</summary>
                            <div class="table-responsive mt-2">
                                <table class="table table-sm mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">批號</th>
                                            <th scope="col">效期</th>
                                            <th scope="col" class="text-end">數量</th>
                                            <th scope="col">儲位</th>
                                            <th scope="col">狀態</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var lot in item.Lots)
                                        {
                                            var isExpired = lot.ExpiryDate < Model.AsOf;
                                            var isZeroQuantity = lot.Quantity == 0;
                                            <tr class="@(!lot.IsAvailable ? "table-warning" : string.Empty)">
                                                <td>@lot.LotNumber</td>
                                                <td>@lot.ExpiryDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                                                <td class="text-end">@lot.Quantity.ToString("N0", dateFormat)</td>
                                                <td>@lot.StorageLocation</td>
                                                <td>
                                                    @if (lot.IsAvailable)
                                                    {
                                                        <span class="badge text-bg-success">可用</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-bg-warning">不可用</span>
                                                        @if (isExpired)
                                                        {
                                                            <span class="ms-1">已過期</span>
                                                        }
                                                        @if (isZeroQuantity)
                                                        {
                                                            <span class="ms-1">零量</span>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/inventory-availability.js" asp-append-version="true"></script>
}
