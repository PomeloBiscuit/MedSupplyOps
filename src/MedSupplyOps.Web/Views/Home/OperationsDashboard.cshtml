@using MedSupplyOps.Domain.Requisitions
@using MedSupplyOps.Web.Localization
@using MedSupplyOps.Web.Models.Home
@model OperationsDashboardViewModel
@inject DisplayTimeZone DisplayTimeZone
@{
    ViewData["Title"] = L["首頁"];
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="mb-0 fs-3 fw-semibold">@L["營運儀表板"]</h1>
    @if (Model.CanCreateRequisition)
    {
        <a class="btn btn-primary" asp-controller="Requisitions" asp-action="Create">@L["建立請領單"]</a>
    }
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3 mb-3 dashboard-operations-grid">
    <div class="col">
        <a class="text-decoration-none" asp-controller="Requisitions" asp-action="Index" asp-route-status="@RequisitionStatus.PendingApproval">
            <div class="card h-100 dashboard-card">
                <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="dashboard-kpi-dot dashboard-kpi-dot-warning"></span>
                    <span class="fw-semibold">@L["待審核"]</span>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="dashboard-kpi-number" data-testid="pending-approval-count">@Model.PendingApprovalCount</span>
                    <span class="text-body-secondary">@L["張"]</span>
                </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col">
        <a class="text-decoration-none" asp-controller="Requisitions" asp-action="Index" asp-route-status="@RequisitionStatus.Approved">
            <div class="card h-100 dashboard-card">
                <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="dashboard-kpi-dot dashboard-kpi-dot-success"></span>
                    <span class="fw-semibold">@L["待發料"]</span>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="dashboard-kpi-number" data-testid="approved-awaiting-issue-count">@Model.ApprovedAwaitingIssueCount</span>
                    <span class="text-body-secondary">@L["張"]</span>
                </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col">
        <a class="text-decoration-none" asp-controller="Inventory" asp-action="Expiring" asp-route-withinDays="30">
            <div class="card h-100 dashboard-card">
                <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="dashboard-kpi-dot dashboard-kpi-dot-warning"></span>
                    <span class="fw-semibold">@L["30 天內到期"]</span>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="dashboard-kpi-number" data-testid="expiring-within-30-days-count">@Model.ExpiringWithin30DaysCount</span>
                    <span class="text-body-secondary">@L["批"]</span>
                </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col">
        <a class="text-decoration-none" asp-controller="Inventory" asp-action="Index">
            <div class="card h-100 dashboard-card">
                <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="dashboard-kpi-dot dashboard-kpi-dot-danger"></span>
                    <span class="fw-semibold">@L["低於安全存量"]</span>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="dashboard-kpi-number" data-testid="below-safety-stock-count">@Model.BelowSafetyStockCount</span>
                    <span class="text-body-secondary">@L["項"]</span>
                </div>
                </div>
            </div>
        </a>
    </div>
</div>

@if (Model.ExpiredInStockCount > 0)
{
    <a class="text-decoration-none" asp-controller="Inventory" asp-action="Index">
        <div class="alert dashboard-alert-card mb-3" role="alert" data-testid="expired-in-stock-alert">
            @L["已過期仍在庫"] <strong data-testid="expired-in-stock-count">@Model.ExpiredInStockCount</strong> @L["批"]
        </div>
    </a>
}

<div class="card mb-3" data-testid="approved-issue-queue">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@L["今日待發料佇列"]</span>
        <span class="small text-muted">@L["依核准時間排序"]</span>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">@L["單號"]</th>
                    <th scope="col">@L["科室"]</th>
                    <th scope="col">@L["品項數"]</th>
                    <th scope="col">@L["核准時間"]（@DisplayTimeZone.Id）</th>
                    <th scope="col"><span class="visually-hidden">@L["操作"]</span></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ApprovedIssueQueue.Count == 0)
                {
                    <tr><td colspan="5" class="text-muted">@L["目前沒有待發料請領單。"]</td></tr>
                }
                else
                {
                    @foreach (var requisition in Model.ApprovedIssueQueue)
                    {
                        <tr data-testid="issue-queue-row" data-approved-at="@requisition.ApprovedAtUtc.ToString("O")">
                            <td class="font-monospace">@requisition.RequisitionNo</td>
                            <td>@requisition.DepartmentName</td>
                            <td>@requisition.LineCount</td>
                            <td>@DisplayTimeZone.Format(requisition.ApprovedAtUtc)</td>
                            <td class="text-end"><a class="btn btn-sm btn-primary" asp-controller="Requisitions" asp-action="Details" asp-route-id="@requisition.Id" asp-fragment="issue-actions">@L["發料"]</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header">@L["最近異動"]</div>
    <ul class="list-group list-group-flush" data-testid="recent-audit-list">
        @if (Model.RecentAudit.Count == 0)
        {
            <li class="list-group-item text-muted">@L["目前沒有稽核紀錄。"]</li>
        }
        else
        {
            @foreach (var entry in Model.RecentAudit)
            {
                var displayTime = DisplayTimeZone.ConvertFromUtc(entry.OccurredAtUtc);
                var timeText = displayTime.ToString("MM-dd HH:mm");
                // ★ AuditFeedItemViewModel.TargetText 把「請領單」這個可翻譯的標籤直接串進資料字串
                //   （當時的改動範圍不含 Web/Models）。
                //   這裡只在畫面端把已知前綴拆開重新翻譯，不去動 Model 產生資料的方式。
                const string requisitionLabelPrefix = "請領單 ";
                var isRequisitionTarget = entry.TargetText.StartsWith(requisitionLabelPrefix, StringComparison.Ordinal);
                var targetDisplay = isRequisitionTarget ? entry.TargetText[requisitionLabelPrefix.Length..] : entry.TargetText;
                <li class="list-group-item dashboard-audit-item d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <span class="text-body-secondary font-monospace" style="min-width: 5.5rem;">@timeText</span>
                    <span class="dashboard-audit-content flex-grow-1">
                        <strong>@entry.ActorDisplay</strong> @L[entry.ActionText]@L["動作完成助詞"]
                        @if (isRequisitionTarget)
                        {
                            @L["請領單"]<text> </text>
                        }
                        @if (entry.TargetRequisitionId is { } requisitionId)
                        {
                            <a asp-controller="Requisitions" asp-action="Details" asp-route-id="@requisitionId">@targetDisplay</a>
                        }
                        else
                        {
                            @targetDisplay
                        }
                    </span>
                </li>
            }
        }
    </ul>
</div>
