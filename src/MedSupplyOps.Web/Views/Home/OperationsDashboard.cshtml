@using MedSupplyOps.Domain.Requisitions
@using MedSupplyOps.Infrastructure.Time
@using MedSupplyOps.Web.Models.Home
@model OperationsDashboardViewModel
@inject BusinessCalendar BusinessCalendar
@{
    ViewData["Title"] = "首頁";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="mb-0 fs-3 fw-semibold">營運儀表板</h1>
    @if (Model.CanCreateRequisition)
    {
        <a class="btn btn-primary" asp-controller="Requisitions" asp-action="Create">建立請領單</a>
    }
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3 mb-3 dashboard-operations-grid">
    <div class="col">
        <a class="text-decoration-none" asp-controller="Requisitions" asp-action="Index" asp-route-status="@RequisitionStatus.PendingApproval">
            <div class="card h-100 dashboard-card">
                <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="dashboard-kpi-dot dashboard-kpi-dot-warning"></span>
                    <span class="fw-semibold">待審核</span>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="dashboard-kpi-number" data-testid="pending-approval-count">@Model.PendingApprovalCount</span>
                    <span class="text-body-secondary">張</span>
                </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col">
        <a class="text-decoration-none" asp-controller="Requisitions" asp-action="Index" asp-route-status="@RequisitionStatus.Approved">
            <div class="card h-100 dashboard-card">
                <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="dashboard-kpi-dot dashboard-kpi-dot-success"></span>
                    <span class="fw-semibold">待發料</span>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="dashboard-kpi-number" data-testid="approved-awaiting-issue-count">@Model.ApprovedAwaitingIssueCount</span>
                    <span class="text-body-secondary">張</span>
                </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col">
        <a class="text-decoration-none" asp-controller="Inventory" asp-action="Expiring" asp-route-withinDays="30">
            <div class="card h-100 dashboard-card">
                <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="dashboard-kpi-dot dashboard-kpi-dot-warning"></span>
                    <span class="fw-semibold">30 天內到期</span>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="dashboard-kpi-number" data-testid="expiring-within-30-days-count">@Model.ExpiringWithin30DaysCount</span>
                    <span class="text-body-secondary">批</span>
                </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col">
        <a class="text-decoration-none" asp-controller="Inventory" asp-action="Index">
            <div class="card h-100 dashboard-card">
                <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="dashboard-kpi-dot dashboard-kpi-dot-danger"></span>
                    <span class="fw-semibold">低於安全存量</span>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="dashboard-kpi-number" data-testid="below-safety-stock-count">@Model.BelowSafetyStockCount</span>
                    <span class="text-body-secondary">項</span>
                </div>
                </div>
            </div>
        </a>
    </div>
</div>

@if (Model.ExpiredInStockCount > 0)
{
    <a class="text-decoration-none" asp-controller="Inventory" asp-action="Index">
        <div class="alert dashboard-alert-card mb-3" role="alert" data-testid="expired-in-stock-alert">
            已過期仍在庫 <strong data-testid="expired-in-stock-count">@Model.ExpiredInStockCount</strong> 批
        </div>
    </a>
}

<div class="card">
    <div class="card-header">最近異動</div>
    <ul class="list-group list-group-flush" data-testid="recent-audit-list">
        @if (Model.RecentAudit.Count == 0)
        {
            <li class="list-group-item text-muted">目前沒有稽核紀錄。</li>
        }
        else
        {
            @foreach (var entry in Model.RecentAudit)
            {
                var businessTime = BusinessCalendar.ToBusinessTime(entry.OccurredAtUtc);
                var isToday = DateOnly.FromDateTime(businessTime) == BusinessCalendar.Today;
                var timeText = isToday ? businessTime.ToString("HH:mm") : businessTime.ToString("MM-dd HH:mm");
                <li class="list-group-item dashboard-audit-item d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <span class="text-body-secondary font-monospace" style="min-width: 5.5rem;">@timeText</span>
                    <span class="dashboard-audit-content flex-grow-1">
                        <strong>@entry.ActorDisplay</strong> @(entry.ActionText)了
                        @if (entry.TargetRequisitionId is { } requisitionId)
                        {
                            <a asp-controller="Requisitions" asp-action="Details" asp-route-id="@requisitionId">@entry.TargetText</a>
                        }
                        else
                        {
                            @entry.TargetText
                        }
                    </span>
                </li>
            }
        }
    </ul>
</div>
