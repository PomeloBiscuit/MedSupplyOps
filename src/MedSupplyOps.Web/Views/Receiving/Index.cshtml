@model MedSupplyOps.Web.Models.Receiving.ReceivingViewModel
@{
    ViewData["Title"] = L["入庫"];
}

<div class="mso-page mso-form-page">
<div class="mso-page-heading mb-4">
    <h1 class="h2 mb-1">@L["入庫"]</h1>
    <p class="text-muted mb-0">@L["批號與儲位會自動去除首尾空白並轉成大寫。"]</p>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

<div class="card card-body mso-form-card">
<form asp-action="Index" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-12">
            <label class="form-label" for="barcode-scan">@L["掃描條碼"]</label>
            <input class="form-control"
                   id="barcode-scan"
                   type="text"
                   maxlength="128"
                   autocomplete="off"
                   autofocus
                   placeholder="@L["請掃描條碼後按 Enter"]"
                   data-lookup-url="@Url.Action("LookupBarcode", "Receiving")"
                   data-text-looking-up="@L["查詢條碼中…"]"
                   data-text-found="@L["已帶入品項：{0}"]"
                   data-text-query-failed="@L["條碼查詢失敗，請稍後再試。"]" />
            <div class="form-text">@L["掃描槍以鍵盤模式輸入；掃描完成後會送出 Enter。"]</div>
            <output class="d-block mt-2" id="barcode-scan-result" aria-live="polite"></output>
        </div>
        <div class="col-12">
            <label asp-for="ItemId" class="form-label"></label>
            <select asp-for="ItemId" class="form-select">
                <option value="0">@L["請選擇品項"]</option>
                @foreach (var item in Model.Items)
                {
                    <option value="@item.Id">@item.Code @item.Name（@item.UnitOfMeasure）</option>
                }
            </select>
            <span asp-validation-for="ItemId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="LotNumber" class="form-label"></label>
            <span class="badge text-bg-info d-none barcode-origin" id="lot-number-barcode-origin">@L["來自條碼"]</span>
            <input asp-for="LotNumber" class="form-control" maxlength="64" autocomplete="off" />
            <span asp-validation-for="LotNumber" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ExpiryDate" class="form-label"></label>
            <span class="badge text-bg-info d-none barcode-origin" id="expiry-date-barcode-origin">@L["來自條碼"]</span>
            <input asp-for="ExpiryDate" class="form-control" type="date" />
            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Quantity" class="form-label"></label>
            <input asp-for="Quantity" class="form-control" type="number" min="1" max="100000" step="1" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="StorageLocation" class="form-label"></label>
            <input asp-for="StorageLocation" class="form-control" maxlength="64" autocomplete="off" />
            <span asp-validation-for="StorageLocation" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4">
        <button class="btn btn-primary" type="submit">@L["確認入庫"]</button>
    </div>
</form>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/receiving-barcode.js" asp-append-version="true"></script>
}
