@using MedSupplyOps.Web.Authorization
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    var canManageItems = (await AuthorizationService.AuthorizeAsync(User, AuthorizationPolicies.ItemManage)).Succeeded;
    var canReceiveStock = (await AuthorizationService.AuthorizeAsync(User, AuthorizationPolicies.StockReceive)).Succeeded;
    var sidebarState = Context.Request.Cookies["mso-sidebar-state"];
    sidebarState = sidebarState is "expanded" or "compact" or "hidden" ? sidebarState : "expanded";
    var themePreference = Context.Request.Cookies["mso-theme"];
    themePreference = themePreference is "light" or "dark" or "system" or "contrast" ? themePreference : "light";
    var bootstrapTheme = themePreference == "dark" ? "dark" : "light";
    var densityPreference = Context.Request.Cookies["mso-density"];
    densityPreference = densityPreference is "comfortable" or "compact" ? densityPreference : "comfortable";
    var useSidebarNavigation = User.Identity?.IsAuthenticated == true &&
        string.Equals(Context.Request.Cookies["mso-navigation-layout"], "sidebar", StringComparison.Ordinal);
}
<!DOCTYPE html>
<html lang="zh-Hant" data-bs-theme="@bootstrapTheme" data-mso-theme="@themePreference" data-density="@densityPreference" data-mso-navigation="@(useSidebarNavigation ? "sidebar" : "top")" data-mso-sidebar-state="@sidebarState">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedSupplyOps</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(useSidebarNavigation ? "mso-sidebar-layout" : "mso-top-navigation-layout")">
@if (useSidebarNavigation)
{
    <div class="mso-app-shell">
        @await Component.InvokeAsync("SidebarNavigation", new { state = sidebarState })
        <div class="mso-app-content">
            <main role="main" class="mso-main @(sidebarState == "hidden" ? "mso-main-wide" : null)">
                @RenderBody()
            </main>
            <partial name="_GlobalFooter" />
        </div>
    </div>
}
else
{
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark mso-navbar">
            <div class="container-xxl mso-shell">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MedSupplyOps</a>
                <span class="mso-navbar-subtitle">醫材耗材請領與庫存管理</span>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="切換導覽">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-lg-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">首頁</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Inventory" asp-action="Index">庫存查詢</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Inventory" asp-action="Expiring">效期預警</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Requisitions" asp-action="Index">請領單</a>
                        </li>
                        @if (canManageItems)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Items" asp-action="Index">品項管理</a>
                            </li>
                        }
                        @if (canReceiveStock)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Receiving" asp-action="Index">入庫</a>
                            </li>
                        }
                        </ul>
                        <ul class="navbar-nav align-items-lg-center">
                            <li class="nav-item d-flex align-items-center me-2">
                                <span class="mso-user-name">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item dropdown">
                                <button class="btn mso-settings-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="設定" title="設定">⚙</button>
                                <div class="dropdown-menu dropdown-menu-end mso-preference-dropdown">
                                    <partial name="_PreferenceMenu" />
                                </div>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container-xxl mso-shell">
        <main role="main" class="mso-main">
            @RenderBody()
        </main>
    </div>

    <partial name="_GlobalFooter" />
}
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="modal fade" id="mso-account-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" data-mso-account-modal-dialog>
            <div class="modal-content">
                <div class="modal-body text-center text-muted py-5" role="status">載入中…</div>
            </div>
        </div>
    </div>
}
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
