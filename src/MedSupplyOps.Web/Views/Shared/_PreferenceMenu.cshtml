@using System.Globalization
@using MedSupplyOps.Web.Localization
@inject DisplayTimeZone DisplayTimeZone
@{
    var theme = Context.Request.Cookies["mso-theme"];
    theme = theme is "light" or "dark" or "system" or "contrast" ? theme : "light";
    var density = Context.Request.Cookies["mso-density"];
    density = density is "comfortable" or "compact" ? density : "comfortable";
    var navigation = Context.Request.Cookies["mso-navigation-layout"] == "sidebar" ? "sidebar" : "top";
    var prefix = "mso-preference-" + Guid.NewGuid().ToString("N");
}
<div class="mso-preference-menu">
    <button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#mso-account-modal" data-mso-account-url="@Url.Action("Profile", "Account")">@L["個人資料"]</button>
    <button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#mso-account-modal" data-mso-account-url="@Url.Action("ChangePassword", "Account")">@L["變更密碼"]</button>
    <div class="dropdown-divider"></div>

    <section class="mso-preference-section" aria-labelledby="@prefix-theme-label">
        <div class="mso-preference-label" id="@prefix-theme-label">@L["版面風格"]</div>
        <div class="btn-group mso-preference-button-group" role="group" aria-label="@L["版面風格"]">
            <input class="btn-check" type="radio" name="@prefix-theme" id="@prefix-theme-light" value="light" data-mso-preference="mso-theme" @(theme == "light" ? "checked" : null) />
            <label class="btn btn-outline-secondary" for="@prefix-theme-light">@L["明亮"]</label>
            <input class="btn-check" type="radio" name="@prefix-theme" id="@prefix-theme-dark" value="dark" data-mso-preference="mso-theme" @(theme == "dark" ? "checked" : null) />
            <label class="btn btn-outline-secondary" for="@prefix-theme-dark">@L["暗色"]</label>
            <input class="btn-check" type="radio" name="@prefix-theme" id="@prefix-theme-system" value="system" data-mso-preference="mso-theme" @(theme == "system" ? "checked" : null) />
            <label class="btn btn-outline-secondary" for="@prefix-theme-system">@L["跟隨系統"]</label>
        </div>
        <div class="form-check form-switch mso-preference-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="@prefix-contrast" data-mso-contrast @(theme == "contrast" ? "checked" : null) />
            <label class="form-check-label" for="@prefix-contrast">@L["高對比（庫房強光下）"]</label>
        </div>
    </section>

    <section class="mso-preference-section" aria-labelledby="@prefix-density-label">
        <div class="mso-preference-label" id="@prefix-density-label">@L["表格密度"]</div>
        <div class="btn-group mso-preference-button-group" role="group" aria-label="@L["表格密度"]">
            <input class="btn-check" type="radio" name="@prefix-density" id="@prefix-density-comfortable" value="comfortable" data-mso-preference="mso-density" @(density == "comfortable" ? "checked" : null) />
            <label class="btn btn-outline-secondary" for="@prefix-density-comfortable">@L["寬鬆"]</label>
            <input class="btn-check" type="radio" name="@prefix-density" id="@prefix-density-compact" value="compact" data-mso-preference="mso-density" @(density == "compact" ? "checked" : null) />
            <label class="btn btn-outline-secondary" for="@prefix-density-compact">@L["緊湊"]</label>
        </div>
    </section>

    <section class="mso-preference-section" aria-labelledby="@prefix-navigation-label">
        <div class="mso-preference-label" id="@prefix-navigation-label">@L["導覽版面"]</div>
        <div class="btn-group mso-preference-button-group" role="group" aria-label="@L["導覽版面"]">
            <input class="btn-check" type="radio" name="@prefix-navigation" id="@prefix-navigation-top" value="top" data-mso-preference="mso-navigation-layout" @(navigation == "top" ? "checked" : null) />
            <label class="btn btn-outline-secondary" for="@prefix-navigation-top">@L["上方導覽列"]</label>
            <input class="btn-check" type="radio" name="@prefix-navigation" id="@prefix-navigation-sidebar" value="sidebar" data-mso-preference="mso-navigation-layout" @(navigation == "sidebar" ? "checked" : null) />
            <label class="btn btn-outline-secondary" for="@prefix-navigation-sidebar">@L["左側摺疊欄"]</label>
        </div>
    </section>

    <div class="dropdown-divider"></div>
    <section class="mso-preference-section" aria-labelledby="@prefix-language-label">
        <div class="mso-preference-label" id="@prefix-language-label">@L["語言"]</div>
        <form asp-controller="Preferences" asp-action="Culture" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" />
            <select class="form-select form-select-sm" name="culture" aria-labelledby="@prefix-language-label" onchange="this.form.submit()">
                <option value="zh-Hant" selected="@(CultureInfo.CurrentUICulture.Name == "zh-Hant")">繁體中文</option>
                <option value="en" selected="@(CultureInfo.CurrentUICulture.Name == "en")">English</option>
                <option value="ja" disabled>日本語（@L["尚未提供"]）</option>
            </select>
        </form>
    </section>
    <section class="mso-preference-section" aria-labelledby="@prefix-time-zone-label">
        <div class="mso-preference-label" id="@prefix-time-zone-label">@L["顯示時區"]</div>
        <form asp-controller="Preferences" asp-action="TimeZone" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" />
            <select class="form-select form-select-sm" name="timeZone" aria-labelledby="@prefix-time-zone-label" onchange="this.form.submit()">
                <option value="Asia/Taipei" selected="@(DisplayTimeZone.Id == "Asia/Taipei")">UTC+08:00 @L["台北"]</option>
                <option value="UTC" selected="@(DisplayTimeZone.Id == "UTC")">UTC</option>
            </select>
        </form>
        <p class="small text-muted mt-2 mb-0">@L["資料一律以 UTC 儲存；清單與稽核時間依此時區顯示。"]</p>
    </section>
    <div class="dropdown-divider"></div>
    <form asp-controller="Account" asp-action="Logout" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="dropdown-item mso-logout">@L["登出"]</button>
    </form>
</div>
