@using MedSupplyOps.Web.Authorization
@using MedSupplyOps.Web.ViewComponents
@model SidebarNavigationViewModel
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isAdministrator = User.IsInRole(ApplicationRoles.Administrator);
    var canManageItems = User.IsInRole(ApplicationRoles.Storekeeper) || isAdministrator;
    var canManageStorageLocations = User.IsInRole(ApplicationRoles.Storekeeper) || isAdministrator;
    var canReceiveStock = User.IsInRole(ApplicationRoles.Storekeeper) || User.IsInRole(ApplicationRoles.Administrator);
    var isCompact = Model.State == "compact";
    var isHidden = Model.State == "hidden";
    var toggleIcon = isCompact ? "expand" : "collapse";
    var navItems = new[]
    {
        new { Name = L["首頁"].Value, Controller = "Home", Action = "Index", Icon = "home", Badge = (int?)null },
        new { Name = L["庫存查詢"].Value, Controller = "Inventory", Action = "Index", Icon = "inventory", Badge = (int?)null },
        new { Name = L["效期預警"].Value, Controller = "Inventory", Action = "Expiring", Icon = "expiry", Badge = Model.ExpiringLotCount > 0 ? (int?)Model.ExpiringLotCount : null },
        new { Name = L["請領單"].Value, Controller = "Requisitions", Action = "Index", Icon = "requisition", Badge = Model.PendingRequisitionCount > 0 ? (int?)Model.PendingRequisitionCount : null },
    };
}

@if (isHidden)
{
    <header class="mso-compact-header">
        <button class="btn mso-navigation-trigger" type="button" data-bs-toggle="offcanvas" data-bs-target="#mso-navigation-offcanvas" aria-controls="mso-navigation-offcanvas" aria-label="@L["開啟導覽"]">
            <partial name="_NavigationIcon" model='"menu"' />
            <span>@L["導覽"]</span>
        </button>
        <a class="mso-compact-brand" asp-controller="Home" asp-action="Index">MedSupplyOps</a>
    </header>
    <div class="offcanvas offcanvas-start mso-navigation-offcanvas" tabindex="-1" id="mso-navigation-offcanvas" aria-labelledby="mso-navigation-offcanvas-label" data-sidebar-width="@Model.SidebarWidth">
        <div class="offcanvas-header">
            <span class="offcanvas-title" id="mso-navigation-offcanvas-label">MedSupplyOps</span>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@L["關閉"]"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            @if (Model.HasRole)
            {
                <div class="mso-offcanvas-navigation">
                    <nav aria-label="@L["主要導覽"]">
                        <div class="mso-sidebar-group-title">@L["作業"]</div>
                        <div class="mso-sidebar-links">
                            @foreach (var item in navItems)
                            {
                                var isCurrent = controller == item.Controller && action == item.Action;
                                <a class="mso-sidebar-link @(isCurrent ? "is-current" : null)" asp-controller="@item.Controller" asp-action="@item.Action" aria-current="@(isCurrent ? "page" : null)" title="@item.Name">
                                    <partial name="_NavigationIcon" model="item.Icon" />
                                    <span>@item.Name</span>
                                    @if (item.Badge is not null)
                                    {
                                        <span class="mso-nav-badge" data-testid="nav-@(item.Icon)-badge">@item.Badge</span>
                                    }
                                </a>
                            }
                            @if (canManageItems)
                            {
                                var isCurrent = controller == "Items" && action == "Index";
                                <a class="mso-sidebar-link @(isCurrent ? "is-current" : null)" asp-controller="Items" asp-action="Index" aria-current="@(isCurrent ? "page" : null)" title="@L["品項管理"]"><partial name="_NavigationIcon" model='"items"' /><span>@L["品項管理"]</span></a>
                            }
                            @if (canManageStorageLocations)
                            {
                                var isCurrent = controller == "StorageLocations";
                                <a class="mso-sidebar-link @(isCurrent ? "is-current" : null)" asp-controller="StorageLocations" asp-action="Index" aria-current="@(isCurrent ? "page" : null)" title="@L["儲藏位置管理"]"><partial name="_NavigationIcon" model='"inventory"' /><span>@L["儲藏位置管理"]</span></a>
                            }
                            @if (isAdministrator)
                            {
                                var isUsersCurrent = controller == "Users";
                                <a class="mso-sidebar-link @(isUsersCurrent ? "is-current" : null)" asp-controller="Users" asp-action="Index" aria-current="@(isUsersCurrent ? "page" : null)" title="@L["使用者管理"]"><partial name="_NavigationIcon" model='"users"' /><span>@L["使用者管理"]</span></a>
                            }
                            @if (canReceiveStock)
                            {
                                var isCurrent = controller == "Receiving" && action == "Index";
                                <a class="mso-sidebar-link @(isCurrent ? "is-current" : null)" asp-controller="Receiving" asp-action="Index" aria-current="@(isCurrent ? "page" : null)" title="@L["入庫"]"><partial name="_NavigationIcon" model='"receive"' /><span>@L["入庫"]</span></a>
                            }
                        </div>
                    </nav>
                </div>
            }
            <div class="mso-sidebar-user mso-offcanvas-user"><partial name="_SidebarUserMenu" model="Model" /></div>
        </div>
        @* 往左拖就關閉 offcanvas。要打開照舊按「導覽」——關著的時候畫面上沒有可以拖的邊。 *@
        <div class="mso-sidebar-drag-handle" role="separator" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100" aria-valuetext="@L["已展開"]" aria-label="@L["往左拖曳以關閉導覽"]" title="@L["往左拖曳以關閉導覽"]" tabindex="0" data-mso-sidebar-drag data-mso-sidebar-target="close"></div>
    </div>
}
else
{
    <aside class="mso-sidebar @(isCompact ? "mso-sidebar-compact" : "mso-sidebar-expanded")" data-sidebar-state="@Model.State" data-sidebar-width="@Model.SidebarWidth">
        <div class="mso-sidebar-brand-row">
            <a class="mso-sidebar-brand" asp-controller="Home" asp-action="Index">@(isCompact ? "MS" : "MedSupplyOps")</a>
            <button class="btn mso-sidebar-toggle" type="button" data-mso-sidebar-toggle aria-expanded="@(isCompact ? "false" : "true")" aria-label="@(isCompact ? L["展開側欄"] : L["收合側欄"])" title="@(isCompact ? L["展開側欄"] : L["收合側欄"])">
                <partial name="_NavigationIcon" model="toggleIcon" />
            </button>
        </div>
        @if (Model.HasRole)
        {
            <nav aria-label="@L["主要導覽"]">
                @if (!isCompact)
                {
                    <div class="mso-sidebar-group-title">@L["作業"]</div>
                }
                <div class="mso-sidebar-links">
                    @foreach (var item in navItems)
                    {
                        var isCurrent = controller == item.Controller && action == item.Action;
                        <a class="mso-sidebar-link @(isCurrent ? "is-current" : null)" asp-controller="@item.Controller" asp-action="@item.Action" aria-current="@(isCurrent ? "page" : null)" data-bs-toggle="@(isCompact ? "tooltip" : null)" data-bs-placement="@(isCompact ? "right" : null)" title="@item.Name">
                            <span class="mso-nav-icon-wrap"><partial name="_NavigationIcon" model="item.Icon" />@if (isCompact && item.Badge is not null) { <span class="mso-nav-badge" data-testid="nav-@(item.Icon)-badge">@item.Badge</span> }</span>
                            @if (!isCompact)
                            {
                                <span>@item.Name</span>
                                @if (item.Badge is not null) { <span class="mso-nav-badge" data-testid="nav-@(item.Icon)-badge">@item.Badge</span> }
                            }
                        </a>
                    }
                    @if (canManageItems)
                    {
                        var isCurrent = controller == "Items" && action == "Index";
                        <a class="mso-sidebar-link @(isCurrent ? "is-current" : null)" asp-controller="Items" asp-action="Index" aria-current="@(isCurrent ? "page" : null)" data-bs-toggle="@(isCompact ? "tooltip" : null)" data-bs-placement="@(isCompact ? "right" : null)" title="@(isCompact ? L["品項管理"].Value : null)"><partial name="_NavigationIcon" model='"items"' />@if (!isCompact) { <span>@L["品項管理"]</span> }</a>
                    }
                    @if (canManageStorageLocations)
                    {
                        var isCurrent = controller == "StorageLocations";
                        <a class="mso-sidebar-link @(isCurrent ? "is-current" : null)" asp-controller="StorageLocations" asp-action="Index" aria-current="@(isCurrent ? "page" : null)" data-bs-toggle="@(isCompact ? "tooltip" : null)" data-bs-placement="@(isCompact ? "right" : null)" title="@(isCompact ? L["儲藏位置管理"].Value : null)"><partial name="_NavigationIcon" model='"inventory"' />@if (!isCompact) { <span>@L["儲藏位置管理"]</span> }</a>
                    }
                    @if (isAdministrator)
                    {
                        var isUsersCurrent = controller == "Users";
                        <a class="mso-sidebar-link @(isUsersCurrent ? "is-current" : null)" asp-controller="Users" asp-action="Index" aria-current="@(isUsersCurrent ? "page" : null)" data-bs-toggle="@(isCompact ? "tooltip" : null)" data-bs-placement="@(isCompact ? "right" : null)" title="@(isCompact ? L["使用者管理"].Value : null)"><partial name="_NavigationIcon" model='"users"' />@if (!isCompact) { <span>@L["使用者管理"]</span> }</a>
                    }
                    @if (canReceiveStock)
                    {
                        var isCurrent = controller == "Receiving" && action == "Index";
                        <a class="mso-sidebar-link @(isCurrent ? "is-current" : null)" asp-controller="Receiving" asp-action="Index" aria-current="@(isCurrent ? "page" : null)" data-bs-toggle="@(isCompact ? "tooltip" : null)" data-bs-placement="@(isCompact ? "right" : null)" title="@(isCompact ? L["入庫"].Value : null)"><partial name="_NavigationIcon" model='"receive"' />@if (!isCompact) { <span>@L["入庫"]</span> }</a>
                    }
                </div>
            </nav>
        }
        <div class="mso-sidebar-user"><partial name="_SidebarUserMenu" model="Model" /></div>
        @* ★ 拖曳手勢：展開時往左拖 → 收合成圖示列；圖示列時往右拖 → 展開。
           寬度本身固定，不提供連續調寬。 *@
        @{
            var dragLabel = isCompact ? L["往右拖曳以展開側欄"] : L["往左拖曳以收合側欄"];
        }
        <div class="mso-sidebar-drag-handle" role="separator" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@(isCompact ? 0 : 100)" aria-valuetext="@(isCompact ? L["已收合"] : L["已展開"])" aria-label="@dragLabel" title="@dragLabel" tabindex="0" data-mso-sidebar-drag data-mso-sidebar-target="@(isCompact ? "expanded" : "compact")"></div>
    </aside>
}
