@using MedSupplyOps.Web.Models.Requisitions
@using MedSupplyOps.Infrastructure.Time
@model RequisitionDetailsViewModel
@inject BusinessCalendar BusinessCalendar
@{
    ViewData["Title"] = $"請領單 {Model.RequisitionNo}";
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h2 mb-1">@Model.RequisitionNo</h1>
        <p class="text-muted mb-0">目前狀態：<strong>@RequisitionStatusText.Get(Model.Status)</strong></p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">返回列表</a>
</div>

<dl class="row card card-body mx-0 mb-4">
    <dt class="col-sm-3">科室</dt>
    <dd class="col-sm-9">@Model.DepartmentName</dd>
    <dt class="col-sm-3">建立時間</dt>
    <dd class="col-sm-9">@BusinessCalendar.ToBusinessTime(Model.CreatedAt).ToString("yyyy-MM-dd HH:mm:ss")</dd>
    <dt class="col-sm-3">送審時間</dt>
    <dd class="col-sm-9">@(Model.SubmittedAt is DateTime submittedAt ? BusinessCalendar.ToBusinessTime(submittedAt).ToString("yyyy-MM-dd HH:mm:ss") : "—")</dd>
    <dt class="col-sm-3">核准時間</dt>
    <dd class="col-sm-9">@(Model.ApprovedAt is DateTime approvedAt ? BusinessCalendar.ToBusinessTime(approvedAt).ToString("yyyy-MM-dd HH:mm:ss") : "—")</dd>
    @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
    {
        <dt class="col-sm-3">駁回原因</dt>
        <dd class="col-sm-9">@Model.RejectionReason</dd>
    }
</dl>

<div class="table-responsive mb-4">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th scope="col">行號</th>
                <th scope="col">品項代碼</th>
                <th scope="col">品項</th>
                <th scope="col" class="text-end">請領數量</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.LineNo</td>
                    <td>@line.ItemCode</td>
                    <td>@line.ItemName</td>
                    <td class="text-end">@line.Quantity @line.UnitOfMeasure</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.IssueAllocations.Count > 0)
{
    <section class="mb-4" aria-labelledby="issue-allocation-heading">
        <h2 class="h4" id="issue-allocation-heading">發料配批明細</h2>
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col">明細行</th>
                        <th scope="col">品項</th>
                        <th scope="col">批號</th>
                        <th scope="col">效期</th>
                        <th scope="col" class="text-end">發料數量</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var allocation in Model.IssueAllocations)
                    {
                        <tr>
                            <td>@allocation.LineNo</td>
                            <td>@allocation.ItemCode（@allocation.ItemName）</td>
                            <td>@allocation.LotNumber</td>
                            <td>@allocation.ExpiryDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">@allocation.Quantity @allocation.UnitOfMeasure</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (Model.CanIssue && (User.IsInRole("Storekeeper") || User.IsInRole("Administrator")))
{
    <section class="card card-body mb-4" aria-labelledby="issue-heading">
        <h2 class="h5" id="issue-heading">發料動作</h2>
        <form asp-action="Issue" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-primary" type="submit">發料</button>
        </form>
    </section>
}

@if (Model.CanRetryIssue && (User.IsInRole("Storekeeper") || User.IsInRole("Administrator")))
{
    <section class="card card-body mb-4" aria-labelledby="retry-issue-heading">
        <h2 class="h5" id="retry-issue-heading">重新嘗試發料</h2>
        <form asp-action="Issue" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-primary" type="submit">重試發料</button>
        </form>
    </section>
}

@if (Model.CanReview && (User.IsInRole("Storekeeper") || User.IsInRole("Administrator")))
{
    <section class="card card-body" aria-labelledby="review-heading">
        <h2 class="h5" id="review-heading">審核動作</h2>
        <div class="d-flex flex-column gap-3">
            <form asp-action="Approve" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                <button class="btn btn-success" type="submit">核准</button>
            </form>
            <form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                <div class="col-md-8">
                    <label class="form-label" for="rejectionReason">駁回原因</label>
                    <textarea class="form-control" id="rejectionReason" name="rejectionReason" maxlength="500" required></textarea>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-danger" type="submit">駁回</button>
                </div>
            </form>
        </div>
    </section>
}
