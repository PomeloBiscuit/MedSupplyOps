@using MedSupplyOps.Web.Models.Requisitions
@using MedSupplyOps.Web.Localization
@model RequisitionDetailsViewModel
@inject DisplayTimeZone DisplayTimeZone

<div class="modal-content">
    <div class="modal-header">
        <div>
            <h2 class="modal-title fs-5" id="requisition-details-modal-title">@Model.RequisitionNo</h2>
            <p class="text-muted mb-0">@L["目前狀態："]<span class="badge @(Model.Status == MedSupplyOps.Domain.Requisitions.RequisitionStatus.Issued ? "mso-badge-ok" : Model.Status == MedSupplyOps.Domain.Requisitions.RequisitionStatus.Rejected ? "mso-badge-bad" : Model.Status == MedSupplyOps.Domain.Requisitions.RequisitionStatus.Draft || Model.Status == MedSupplyOps.Domain.Requisitions.RequisitionStatus.Closed ? "mso-badge-idle" : "mso-badge-warn")">@L[RequisitionStatusText.Get(Model.Status)]</span></p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["關閉"]"></button>
    </div>
    <div class="modal-body">
        <dl class="row card card-body mx-0 mb-4 mso-detail-list">
            <dt class="col-sm-3">@L["科室"]</dt>
            <dd class="col-sm-9">@Model.DepartmentName</dd>
            <dt class="col-sm-3">@L["建立時間"]</dt>
            <dd class="col-sm-9">@DisplayTimeZone.Format(Model.CreatedAt)（@DisplayTimeZone.Id）</dd>
            <dt class="col-sm-3">@L["送審時間"]</dt>
            <dd class="col-sm-9">@(Model.SubmittedAt is DateTime submittedAt ? DisplayTimeZone.Format(submittedAt) : "—")</dd>
            <dt class="col-sm-3">@L["核准時間"]</dt>
            <dd class="col-sm-9">@(Model.ApprovedAt is DateTime approvedAt ? DisplayTimeZone.Format(approvedAt) : "—")</dd>
            @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
            {
                <dt class="col-sm-3">@L["駁回原因"]</dt>
                <dd class="col-sm-9 mso-long-text">@Model.RejectionReason</dd>
            }
        </dl>

        <section class="card mso-table-card mb-4" aria-labelledby="requisition-panel-lines-heading">
            <div class="card-header"><h3 class="h5 mb-0" id="requisition-panel-lines-heading">@L["請領明細"]</h3></div>
            <div class="table-responsive mso-table-scroll">
                <table class="table table-striped align-middle mb-0 mso-data-table">
                    <thead>
                        <tr>
                            <th scope="col">@L["行號"]</th>
                            <th scope="col">@L["品項代碼"]</th>
                            <th scope="col">@L["品項"]</th>
                            <th scope="col" class="text-end">@L["請領數量"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td>@line.LineNo</td>
                                <td class="mso-code-cell">@line.ItemCode</td>
                                <td class="mso-long-text">@line.ItemName</td>
                                <td class="text-end">@line.Quantity @line.UnitOfMeasure</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @if (Model.IssueAllocations.Count > 0)
        {
            <section class="card mso-table-card mb-4" aria-labelledby="requisition-panel-allocation-heading">
                <div class="card-header"><h3 class="h5 mb-0" id="requisition-panel-allocation-heading">@L["發料配批明細"]</h3></div>
                <div class="table-responsive mso-table-scroll">
                    <table class="table table-striped align-middle mb-0 mso-data-table">
                        <thead>
                            <tr>
                                <th scope="col">@L["明細行"]</th>
                                <th scope="col">@L["品項"]</th>
                                <th scope="col">@L["批號"]</th>
                                <th scope="col">@L["效期"]</th>
                                <th scope="col" class="text-end">@L["發料數量"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var allocation in Model.IssueAllocations)
                            {
                                <tr>
                                    <td>@allocation.LineNo</td>
                                    <td class="mso-long-text"><span class="mso-code-cell">@allocation.ItemCode</span>（@allocation.ItemName）</td>
                                    <td class="mso-code-cell">@allocation.LotNumber</td>
                                    <td>@allocation.ExpiryDate.ToString("yyyy-MM-dd")</td>
                                    <td class="text-end">@allocation.Quantity @allocation.UnitOfMeasure</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        @if (Model.CanIssue && (User.IsInRole("Storekeeper") || User.IsInRole("Administrator")))
        {
            <section class="card card-body mb-4" aria-labelledby="requisition-panel-issue-heading">
                <h3 class="h5" id="requisition-panel-issue-heading">@L["發料動作"]</h3>
                <form asp-action="Issue" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button class="btn btn-primary" type="submit">@L["發料"]</button>
                </form>
            </section>
        }

        @if (Model.CanRetryIssue && (User.IsInRole("Storekeeper") || User.IsInRole("Administrator")))
        {
            <section class="card card-body mb-4" aria-labelledby="requisition-panel-retry-heading">
                <h3 class="h5" id="requisition-panel-retry-heading">@L["重新嘗試發料"]</h3>
                <form asp-action="Issue" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button class="btn btn-outline-primary" type="submit">@L["重試發料"]</button>
                </form>
            </section>
        }

        @if (Model.CanReview && (User.IsInRole("Storekeeper") || User.IsInRole("Administrator")))
        {
            <section class="card card-body" aria-labelledby="requisition-panel-review-heading">
                <h3 class="h5" id="requisition-panel-review-heading">@L["審核動作"]</h3>
                <div class="d-flex flex-column gap-3">
                    <form asp-action="Approve" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <button class="btn btn-success" type="submit">@L["核准請領單"]</button>
                    </form>
                    <form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <div class="col-md-8">
                            <label class="form-label" for="panelRejectionReason">@L["駁回原因"]</label>
                            <textarea class="form-control" id="panelRejectionReason" name="rejectionReason" maxlength="500" required></textarea>
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-danger" type="submit">@L["駁回請領單"]</button>
                        </div>
                    </form>
                </div>
            </section>
        }
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["關閉"]</button>
    </div>
</div>
