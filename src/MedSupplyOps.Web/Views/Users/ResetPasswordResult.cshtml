@model MedSupplyOps.Web.Models.Users.ResetPasswordResultViewModel
@{
    ViewData["Title"] = L["密碼已重設"];
}

<div class="mso-page mso-form-page">
    <div class="mso-page-heading mb-4">
        <h1 class="h2 mb-1">@L["密碼已重設"]</h1>
        <p class="text-muted mb-0">@L["這組新密碼只會顯示這一次。"]</p>
    </div>
    <div class="alert alert-warning" role="alert">
        <strong>@L["請立即交付當事人並要求其變更密碼。"]</strong>
        @L["離開或重新整理本頁後，系統不會再次顯示這組密碼。"]
    </div>
    <div class="card card-body mso-form-card">
        <dl class="row mb-0">
            <dt class="col-sm-4">@L["姓名"]</dt>
            <dd class="col-sm-8">@Model.DisplayName</dd>
            <dt class="col-sm-4">@L["Email"]</dt>
            <dd class="col-sm-8">@Model.Email</dd>
            <dt class="col-sm-4">@L["新密碼"]</dt>
            <dd class="col-sm-8"><code data-testid="new-password">@Model.NewPassword</code></dd>
        </dl>
    </div>
    <a class="btn btn-primary mt-4" asp-action="Index">@L["返回使用者管理"]</a>
</div>
