@model MedSupplyOps.Web.Models.Items.CreateItemViewModel
@{
    ViewData["Title"] = "新增品項";
}

<h1 class="h2 mb-4">新增品項</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" maxlength="32" autocomplete="off" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" maxlength="200" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Specification" class="form-label"></label>
            <textarea asp-for="Specification" class="form-control" maxlength="400" rows="3"></textarea>
            <span asp-validation-for="Specification" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="UnitOfMeasure" class="form-label"></label>
            <input asp-for="UnitOfMeasure" class="form-control" maxlength="20" />
            <span asp-validation-for="UnitOfMeasure" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="SafetyStockQty" class="form-label"></label>
            <input asp-for="SafetyStockQty" class="form-control" type="number" min="0" max="1000000" step="1" />
            <span asp-validation-for="SafetyStockQty" class="text-danger"></span>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary" type="submit">新增</button>
        <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
