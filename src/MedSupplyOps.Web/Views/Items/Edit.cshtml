@model MedSupplyOps.Web.Models.Items.EditItemViewModel
@{
    ViewData["Title"] = L["編輯品項"];
}

<div class="mso-page mso-form-page">
<div class="mso-page-heading mb-4">
    <h1 class="h2 mb-1">@L["編輯品項"]</h1>
    <p class="text-muted mb-0">更新品項名稱、規格與安全存量。</p>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

    <div class="card card-body mso-form-card">
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" readonly aria-readonly="true" />
            <div class="form-text">料號建立後不可修改。</div>
        </div>
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" maxlength="200" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Specification" class="form-label"></label>
            <textarea asp-for="Specification" class="form-control" maxlength="400" rows="3"></textarea>
            <span asp-validation-for="Specification" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="UnitOfMeasure" class="form-label"></label>
            <input asp-for="UnitOfMeasure" class="form-control" readonly aria-readonly="true" />
            <div class="form-text">計量單位建立後不可修改；建錯時請停用並建立新品項。</div>
        </div>
        <div class="col-md-6">
            <label asp-for="SafetyStockQty" class="form-label"></label>
            <input asp-for="SafetyStockQty" class="form-control" type="number" min="0" max="1000000" step="1" />
            <span asp-validation-for="SafetyStockQty" class="text-danger"></span>
        </div>
    </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary" type="submit">@L["儲存"]</button>
        <a class="btn btn-outline-secondary" asp-action="Index">@L["取消"]</a>
    </div>
</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
