@model MedSupplyOps.Web.Models.Items.ItemIndexViewModel
@{
    ViewData["Title"] = L["品項管理"];
}

<div class="mso-page">
<div class="mso-page-heading d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">@L["品項管理"]</h1>
        <p class="text-muted mb-0">@L["維護可供請領與入庫使用的品項主檔。"]</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">@L["新增品項"]</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<form method="get" class="card card-body mb-4" role="search">
    <div class="row g-3 align-items-end">
        <div class="col-md-8">
            <label class="form-label" for="search">@L["搜尋品項"]</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" maxlength="400" />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button class="btn btn-outline-primary" type="submit">@L["搜尋"]</button>
            <a class="btn btn-outline-secondary" asp-action="Index">@L["清除"]</a>
        </div>
    </div>
</form>

<section class="card mso-table-card" aria-labelledby="item-list-heading">
    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h2 class="h5 mb-0" id="item-list-heading">@L["品項主檔"]</h2>
        <span class="text-muted small">@L["料號建立後不可修改"]</span>
    </div>
<div class="table-responsive mso-table-scroll">
    <table class="table align-middle mb-0 mso-data-table">
        <thead>
            <tr>
                <th scope="col">@L["料號"]</th>
                <th scope="col">@L["條碼"]</th>
                <th scope="col">@L["名稱"]</th>
                <th scope="col">@L["規格"]</th>
                <th scope="col">@L["單位"]</th>
                <th scope="col" class="text-end">@L["安全存量"]</th>
                <th scope="col"><span class="visually-hidden">@L["操作"]</span></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="7" class="mso-empty-state text-center">@L["目前沒有可管理的品項。"]</td></tr>
            }
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="mso-code-cell">@item.Code</td>
                    <td class="mso-code-cell">@item.Barcode</td>
                    <td class="text-break mso-long-text">@item.Name</td>
                    <td class="text-break">@item.Specification</td>
                    <td>@item.UnitOfMeasure</td>
                    <td class="text-end">@item.SafetyStockQty.ToString("N0")</td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">@L["編輯品項"]</a>
                        <form asp-action="Disable" asp-route-id="@item.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger" type="submit">@L["停用品項"]</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</section>
</div>
