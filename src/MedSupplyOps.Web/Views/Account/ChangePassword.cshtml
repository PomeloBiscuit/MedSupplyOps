@using MedSupplyOps.Web.Models.Account
@model ChangePasswordViewModel
@{
    Layout = null;
}
<div class="modal-content mso-account-dialog" data-mso-account-dialog-kind="change-password">
    <div class="modal-header">
        <h2 class="modal-title fs-5">@L["變更密碼"]</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
    </div>
    <form asp-controller="Account" asp-action="ChangePassword" method="post" data-mso-account-form>
        @Html.AntiForgeryToken()
        <div class="modal-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                    <button type="button" class="btn btn-outline-secondary" data-mso-password-toggle="CurrentPassword">@L["顯示"]</button>
                </div>
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="NewPassword" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password"
                           data-mso-password-input
                           data-required-length="@Model.PasswordPolicy.RequiredLength"
                           data-required-unique="@Model.PasswordPolicy.RequiredUniqueChars"
                           data-require-digit="@Model.PasswordPolicy.RequireDigit.ToString().ToLowerInvariant()"
                           data-require-lowercase="@Model.PasswordPolicy.RequireLowercase.ToString().ToLowerInvariant()"
                           data-require-uppercase="@Model.PasswordPolicy.RequireUppercase.ToString().ToLowerInvariant()"
                           data-require-symbol="@Model.PasswordPolicy.RequireNonAlphanumeric.ToString().ToLowerInvariant()" />
                    <button type="button" class="btn btn-outline-secondary" data-mso-password-toggle="NewPassword">@L["顯示"]</button>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="mso-password-policy" aria-label="密碼規則">
                @foreach (var rule in Model.PasswordPolicy.Rules)
                {
                    <span data-mso-password-rule="@rule.Code"><span aria-hidden="true">·</span> @L[rule.Description]</span>
                }
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <button type="button" class="btn btn-outline-secondary" data-mso-password-toggle="ConfirmPassword">@L["顯示"]</button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <p class="small text-muted mb-0">更新後，目前裝置會重新簽入，其他裝置的既有登入會失效。</p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["取消"]</button>
            <button type="submit" class="btn btn-primary">@L["更新密碼"]</button>
        </div>
    </form>
</div>
