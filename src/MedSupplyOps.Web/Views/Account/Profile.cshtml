@using MedSupplyOps.Web.Models.Account
@model ProfileViewModel
@{
    Layout = null;
}
<div class="modal-content mso-account-dialog" data-mso-account-dialog-kind="profile">
    <div class="modal-header">
        <h2 class="modal-title fs-5">@L["個人資料"]</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
    </div>
    <div class="modal-body">
        <div class="mso-profile-heading">
            <span class="mso-profile-initial" aria-hidden="true">@Model.Initial</span>
            <div>
                <strong>@Model.DisplayName</strong>
                <span>@Model.RoleName</span>
            </div>
        </div>
        <dl class="mso-profile-fields">
            <div><dt>@L["姓名"]</dt><dd>@Model.DisplayName</dd></div>
            <div><dt>@L["Email（帳號）"]</dt><dd class="font-monospace">@Model.Email</dd></div>
            <div><dt>@L["角色"]</dt><dd>@Model.RoleName</dd></div>
            <div><dt>@L["所屬科室"]</dt><dd>@Model.DepartmentName</dd></div>
        </dl>
        <p class="mso-profile-note mb-0">個人資料為唯讀；如需修改請聯絡系統管理員。</p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@L["關閉"]</button>
    </div>
</div>
