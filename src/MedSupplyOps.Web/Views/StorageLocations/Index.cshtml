@using MedSupplyOps.Web.Authorization
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model MedSupplyOps.Web.Models.StorageLocations.StorageLocationIndexViewModel
@{
    ViewData["Title"] = L["儲藏位置管理"];
    var canDeactivate = (await AuthorizationService.AuthorizeAsync(User, AuthorizationPolicies.StorageLocationDeactivate)).Succeeded;
}

<div class="mso-page">
<div class="mso-page-heading d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">@L["儲藏位置管理"]</h1>
        <p class="text-muted mb-0">@L["維護入庫可選擇的儲藏位置主檔。"]</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">@L["新增儲藏位置"]</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<section class="card mso-table-card" aria-labelledby="storage-location-list-heading">
    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h2 class="h5 mb-0" id="storage-location-list-heading">@L["儲藏位置主檔"]</h2>
        <span class="text-muted small">@L["代碼與名稱建立後不可修改"]</span>
    </div>
    <div class="table-responsive mso-table-scroll">
        <table class="table align-middle mb-0 mso-data-table">
            <thead>
                <tr>
                    <th scope="col">@L["儲藏位置代碼"]</th>
                    <th scope="col">@L["儲藏位置名稱"]</th>
                    <th scope="col"><span class="visually-hidden">@L["操作"]</span></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Locations.Count == 0)
                {
                    <tr><td colspan="3" class="mso-empty-state text-center">@L["目前沒有可管理的儲藏位置。"]</td></tr>
                }
                @foreach (var location in Model.Locations)
                {
                    <tr>
                        <td class="mso-code-cell">@location.Code</td>
                        <td class="text-break">@location.Name</td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@location.Id">@L["編輯英文名稱"]</a>
                            @if (canDeactivate)
                            {
                                <form asp-action="Disable" asp-route-id="@location.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" type="submit">@L["停用儲藏位置"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
</div>
